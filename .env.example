# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL="https://gentedigital.com.br"

# Supabase Credentials
# Provide your Supabase URL and Anon Key below to enable the database integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Realtime é opt-in; mantenha false até validar o endpoint WebSocket em produção.
NEXT_PUBLIC_ENABLE_REALTIME=false

# IXC Soft Credentials
IXC_DOMAIN=ixc.suaempresa.com.br
IXC_TOKEN=
# Lista obrigatória em produção para impedir SSRF; hosts separados por vírgula.
IXC_ALLOWED_HOSTS=ixc.suaempresa.com.br

# OpenRouter API Key (para funcionalidades de IA)
OPENROUTER_API_KEY=

# Webhook Secret usado para HMAC SHA-256.
# O remetente deve enviar:
# x-webhook-timestamp=<unix seconds>
# x-webhook-id=<idempotency id>
# x-webhook-signature=sha256=<hex(HMAC(secret, timestamp + "." + raw_body))>
WEBHOOK_SECRET=
IXC_WEBHOOK_SECRET=

# Upstash Redis (Rate Limiting das rotas públicas e de IA)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Token obrigatório para scraping do endpoint interno de métricas.
METRICS_SECRET=

# WhatsApp comercial opcional exibido após o cadastro público, com DDI e DDD.
NEXT_PUBLIC_SALES_WHATSAPP=55XXXXXXXXXXX

# Controle de Acesso (RBAC) - E-mails autorizados separados por vírgula
ADMIN_EMAILS="admin@suaempresa.com.br,outro@suaempresa.com.br"
