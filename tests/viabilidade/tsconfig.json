{
  "include": [
    "../../lib/viabilidade/**/*.ts"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "../../.test-build/viabilidade",
    "exactOptionalPropertyTypes": true,
    "rootDir": "../../lib/viabilidade",
    "strict": true,
    "target": "ES2022",
    "moduleResolution": "Node",
    "module": "CommonJS",
    "types": [
      "node"
    ],
    "esModuleInterop": true
  }
}